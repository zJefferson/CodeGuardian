# Copie para .env e ajuste os valores. Nunca versione o arquivo .env real.
# Não coloque tokens ou credenciais neste arquivo de exemplo.

# Ambiente de execução: development | production
APP_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Execução isolada dos testes dos repositórios (docs/testes-isolados.md).
# Somente o valor exato "enabled" ativa; requer Docker e a imagem construída.
# Atenção: estas variáveis precisam estar no ambiente do processo da API.
CODEGUARDIAN_TEST_EXECUTION=disabled
CODEGUARDIAN_TEST_IMAGE=codeguardian/pytest-runner:0.1.0
