# Variáveis de configuração do CodeGuardian. Nenhuma é obrigatória.
# Atenção: o arquivo .env NÃO é carregado automaticamente. Defina as variáveis no
# ambiente do processo da API antes de iniciá-la (ex.: $env:NOME = "valor" no PowerShell).
# Nunca versione um .env real nem coloque tokens ou credenciais aqui.

# Execução isolada dos testes dos repositórios (docs/testes-isolados.md).
# Somente o valor exato "enabled" ativa; requer Docker e a imagem construída.
CODEGUARDIAN_TEST_EXECUTION=disabled
CODEGUARDIAN_TEST_IMAGE=codeguardian/pytest-runner:0.1.0

# Explicações opcionais com IA local via Ollama (docs/ia-local.md).
# Somente "enabled" ativa; a URL deve ser local (loopback).
CODEGUARDIAN_AI_EXPLANATIONS=disabled
CODEGUARDIAN_OLLAMA_URL=http://127.0.0.1:11434
CODEGUARDIAN_OLLAMA_MODEL=qwen2.5-coder:7b
